          <mxGeometry x="300" y="280" width="120" height="60" fill="white" stroke="black" strokeWidth="1.5"/>
        </mxCell>
        
        <!-- Check Stock Level -->
        <mxCell id="uc-stock" value="Check Stock Level" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="480" y="280" width="120" height="60" fill="white" stroke="black" strokeWidth="1.5"/>
        </mxCell>
        
        <!-- Track Medication Usage -->
        <mxCell id="uc-track" value="Track Medication Usage" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1">
