        <mxCell id="rel-p-request" value="" style="endArrow=open;html=1;strokeWidth=2;" edge="1" parent="1" source="patient" target="uc-request">
          <mxGeometry width="160" height="160" relative="1" as="geometry">
            <mxPoint x="200" y="200" as="sourcePoint"/>
            <mxPoint x="300" y="200" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        
        <!-- Pharmacist to Verify -->
