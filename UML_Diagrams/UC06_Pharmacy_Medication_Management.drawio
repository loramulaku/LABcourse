  <diagram id="uc06-pharmacy" name="UC06 - Pharmacy &amp; Medication Management">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="1400" background="none" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- System Boundary -->
        <mxCell id="boundary" value="Pharmacy &amp; Medication Management System" style="rectangle;html=1;rounded=0;whiteSpace=wrap;fontSize=14;fontStyle=1;align=center;verticalAlign=top;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="250" y="100" width="450" height="550" fill="none" stroke="black" strokeWidth="2"/>
        </mxCell>
        
        <!-- Actors -->
        <!-- Patient -->
        <mxCell id="patient" value="Patient" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="250" width="80" height="80" fill="white" stroke="black" strokeWidth="1.5"/>
        </mxCell>
        
        <!-- Pharmacist -->
        <mxCell id="pharmacist" value="Pharmacist" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="870" y="250" width="80" height="80" fill="white" stroke="black" strokeWidth="1.5"/>
        </mxCell>
        
        <!-- Use Cases -->
        <!-- Request Prescription -->
        <mxCell id="uc-request" value="Request Prescription" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="150" width="120" height="60" fill="white" stroke="black" strokeWidth="1.5"/>
        </mxCell>
        
        <!-- Verify Prescription -->
        <mxCell id="uc-verify-rx" value="Verify Prescription" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1">
